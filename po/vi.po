#: lib/dock.js:581
msgid "Downloads"
msgstr "Tải về"

#: lib/dock.js:590
msgid "Trash"
msgstr "Thùng rác"

#: lib/dock.js:600
msgid "Show Apps"
msgstr "Hiện ứng dụng"

#: lib/dock.js:818
msgid "Open"
msgstr "Mở"

#: lib/dock.js:910
msgid "No files"
msgstr "Không có tệp nào"

#: lib/dock.js:912
msgid "Open Downloads"
msgstr "Mở thư mục Tải về"

#: lib/dock.js:946
msgid "Open in Files"
msgstr "Mở trong Tệp"

#: lib/dock.js:978
msgid "Open Trash"
msgstr "Mở Thùng rác"

#: lib/dock.js:981 lib/dock.js:1004
msgid "Empty Trash"
msgstr "Dọn sạch thùng rác"

#: lib/dock.js:994
msgid "Empty all items from Trash?"
msgstr "Dọn sạch mọi thứ trong Thùng rác?"

#: lib/dock.js:995
msgid "All items in the Trash will be permanently deleted."
msgstr "Mọi thứ trong Thùng rác sẽ bị xoá vĩnh viễn."

#: lib/dock.js:998 lib/installer.js:223
msgid "Cancel"
msgstr "Huỷ"

#: lib/dock.js:1100 prefs.js:198
msgid "Drop to install"
msgstr "Thả để cài đặt"

#: lib/dock.js:1100
msgid "This file cannot be installed"
msgstr "Không thể cài đặt tệp này"

#: lib/dock.js:1157
#, javascript-format
msgid "Installing %s…"
msgstr "Đang cài %s…"

#: lib/dock.js:1157
#, javascript-format
msgid "Waiting to install %s…"
msgstr "Đang chờ cài %s…"

#: lib/installer.js:34
#, javascript-format
msgid "AppImages are moved to %s and added to the dock."
msgstr "AppImage sẽ được chuyển vào %s và thêm lên dock."

#: lib/installer.js:41
msgid ""
"Flatpak apps are installed for your user and added to the dock. Downloading "
"may take a while."
msgstr ""
"Ứng dụng Flatpak sẽ được cài cho tài khoản của bạn và thêm lên dock. Việc "
"tải về có thể mất một lúc."

#: lib/installer.js:46 lib/installer.js:411
msgid ""
"RPM packages are not supported on this system. Use Flatpak or AppImage "
"instead."
msgstr "Hệ thống này không hỗ trợ gói RPM. Hãy dùng Flatpak hoặc AppImage."

#: lib/installer.js:50
msgid ""
"RPM packages are installed for the whole system with dnf, which asks for "
"your password."
msgstr ""
"Gói RPM sẽ được cài cho toàn hệ thống bằng dnf; bạn sẽ được hỏi mật khẩu."

#: lib/installer.js:55 lib/installer.js:416
msgid "DEB packages are not supported on this system."
msgstr "Hệ thống này không hỗ trợ gói DEB."

#: lib/installer.js:59
msgid ""
"DEB packages are installed for the whole system with apt, which asks for "
"your password."
msgstr "Gói DEB sẽ được cài cho toàn hệ thống bằng apt; bạn sẽ được hỏi mật khẩu."

#: lib/installer.js:118 lib/installer.js:288
#, javascript-format
msgid "Could not install %s"
msgstr "Không thể cài %s"

#: lib/installer.js:169 lib/installer.js:197 lib/installer.js:201
#, javascript-format
msgid "Replace “%s”?"
msgstr "Thay thế “%s”?"

#: lib/installer.js:170
#, javascript-format
msgid "%s is already installed. It will be replaced by %s."
msgstr "%s đã được cài. Bản này sẽ được thay bằng %s."

#: lib/installer.js:173
#, javascript-format
msgid "Install “%s”?"
msgstr "Cài đặt “%s”?"

#: lib/installer.js:176
msgid "Install these apps?"
msgstr "Cài đặt các ứng dụng này?"

#: lib/installer.js:179
#, javascript-format
msgid "%s (replaces the installed %s)"
msgstr "%s (thay cho %s đã cài)"

#: lib/installer.js:187
msgid "Only install apps from sources you trust."
msgstr "Chỉ cài ứng dụng từ nguồn bạn tin tưởng."

#: lib/installer.js:188 lib/installer.js:209
msgid "Replace"
msgstr "Thay thế"

#: lib/installer.js:188
msgid "Install"
msgstr "Cài đặt"

#: lib/installer.js:202
#, javascript-format
msgid ""
"%s comes with the same launcher as %s, which is already installed from %s. "
"If you go on, the launcher and dock icon of %s will open %s instead."
msgstr ""
"%s đi kèm trình khởi chạy trùng với %s, ứng dụng đã được cài từ %s. Nếu tiếp "
"tục, trình khởi chạy và biểu tượng trên dock của %s sẽ mở %s thay thế."

#: lib/installer.js:273
msgid "It has no launcher, so it cannot be added to the dock."
msgstr "Ứng dụng không có biểu tượng khởi chạy nên không thể thêm lên dock."

#: lib/installer.js:275 lib/installer.js:277
msgid "It has been added to the dock."
msgstr "Ứng dụng đã được thêm lên dock."

#: lib/installer.js:277
msgid "It will show up in the app grid."
msgstr "Ứng dụng sẽ xuất hiện trong lưới ứng dụng."

#: lib/installer.js:278
#, javascript-format
msgid "%s is updated"
msgstr "Đã cập nhật %s"

#: lib/installer.js:278
#, javascript-format
msgid "%s is installed"
msgstr "Đã cài %s"

#: lib/installer.js:284
#, javascript-format
msgid "Installation of %s was cancelled"
msgstr "Đã huỷ cài đặt %s"

#: lib/installer.js:360
#, javascript-format
msgid ""
"%s is already in %s, but was not installed by GlideDock. If you go on, it is "
"moved to the Trash."
msgstr ""
"%s đã có trong %s nhưng không do GlideDock cài. Nếu tiếp tục, tệp đó sẽ được "
"chuyển vào Thùng rác."

#: lib/installer.js:363
#, javascript-format
msgid "Warning: %s is not signed, so there is no way to tell who made it."
msgstr "Cảnh báo: %s không được ký, nên không thể biết ai đã tạo ra nó."

#: lib/installer.js:365
#, javascript-format
msgid "Warning: %s is signed with a key this system does not trust."
msgstr "Cảnh báo: %s được ký bằng một khóa mà hệ thống này không tin cậy."

#: lib/installer.js:367
#, javascript-format
msgid ""
"Warning: the signature of %s does not match its contents. It may have been "
"tampered with."
msgstr ""
"Cảnh báo: chữ ký của %s không khớp với nội dung. Tệp có thể đã bị sửa đổi."

#: lib/installer.js:370
#, javascript-format
msgid "Package %s: %s"
msgstr "Gói %s: %s"

#: lib/installer.js:371
#, javascript-format
msgid "Package %s"
msgstr "Gói %s"

#: lib/installer.js:373
#, javascript-format
msgid "The signature of %s could not be verified: dpkg-sig is not installed."
msgstr "Không thể xác minh chữ ký của %s vì chưa cài dpkg-sig."

#: lib/installer.js:375
#, javascript-format
msgid ""
"Flatpak permissions are not shown. Review permissions after install with: %s"
msgstr ""
"Quyền của ứng dụng Flatpak không được hiển thị. Sau khi cài, hãy xem lại "
"quyền bằng lệnh: %s"

#: lib/installer.js:391
msgid "The file could not be found."
msgstr "Không tìm thấy tệp."

#: lib/installer.js:393
msgid "This file is not an AppImage."
msgstr "Tệp này không phải là AppImage."

#: lib/installer.js:395
#, javascript-format
msgid "Flatpak is not installed. Install it with “%s”, then try again."
msgstr "Flatpak chưa được cài. Hãy cài bằng “%s” rồi thử lại."

#: lib/installer.js:398
#, javascript-format
msgid ""
"A runtime it needs was not found. Add Flathub for your user with “%s”, then "
"try again."
msgstr ""
"Không tìm thấy runtime mà ứng dụng cần. Hãy thêm Flathub cho tài khoản của "
"bạn bằng “%s” rồi thử lại."

#: lib/installer.js:401
msgid "Its repository could not be reached, or does not have this app."
msgstr "Không kết nối được kho chứa ứng dụng, hoặc kho không có ứng dụng này."

#: lib/installer.js:403
msgid "The download failed. Check the internet connection, then try again."
msgstr "Tải về thất bại. Hãy kiểm tra kết nối mạng rồi thử lại."

#: lib/installer.js:405
msgid "This is not a valid Flatpak file."
msgstr "Đây không phải là tệp Flatpak hợp lệ."

#: lib/installer.js:407
msgid "This file installs a runtime, not an app."
msgstr "Tệp này cài một runtime, không phải ứng dụng."

#: lib/installer.js:409
msgid "There is not enough disk space."
msgstr "Không đủ dung lượng ổ đĩa."

#: lib/installer.js:413
#, javascript-format
msgid "pkexec is not available. Install it with “%s”, then try again."
msgstr "Không có pkexec. Hãy cài bằng “%s” rồi thử lại."

#: lib/installer.js:418
msgid "This is not a valid DEB package."
msgstr "Đây không phải là gói DEB hợp lệ."

#: lib/installer.js:420
msgid "Your account is not allowed to install software."
msgstr "Tài khoản của bạn không được phép cài phần mềm."

#: lib/installer.js:422
msgid "Some packages it depends on could not be found."
msgstr "Không tìm thấy một số gói phụ thuộc mà gói này cần."

#: lib/installer.js:424
#, javascript-format
msgid ""
"Its signature is not trusted. If you trust where it comes from, install it "
"in a terminal with “%s”."
msgstr ""
"Chữ ký của gói không được tin cậy. Nếu bạn tin nguồn của gói, hãy cài trong "
"terminal bằng “%s”."

#: lib/installer.js:427
msgid "It is made for a different kind of computer."
msgstr "Gói này dành cho loại máy tính khác."

#: lib/installer.js:429
msgid "A newer version is installed already."
msgstr "Máy đã có phiên bản mới hơn."

#: lib/installer.js:431
msgid "Another installation is running. Try again once it has finished."
msgstr "Đang có một tiến trình cài đặt khác. Hãy thử lại khi nó xong."

#: lib/installer.js:433
msgid "This is not a valid RPM package."
msgstr "Đây không phải là gói RPM hợp lệ."

#: lib/installer.js:435
msgid "This is a source package: the code to build an app, not the app itself."
msgstr ""
"Đây là gói mã nguồn, dùng để build ứng dụng, không phải bản ứng dụng để cài."

#: prefs.js:109
msgid "Position & Size"
msgstr "Vị trí & Kích thước"

#: prefs.js:111
msgid "Screen & Position"
msgstr "Màn hình & Vị trí"

#: prefs.js:113
msgid "Position on screen"
msgstr "Vị trí trên màn hình"

#: prefs.js:113
msgid "Screen edge the dock is attached to"
msgstr "Cạnh màn hình mà dock bám vào"

#: prefs.js:114
msgid "Bottom"
msgstr "Dưới đáy"

#: prefs.js:115
msgid "Left"
msgstr "Trái"

#: prefs.js:116
msgid "Right"
msgstr "Phải"

#: prefs.js:119
msgid "Alignment"
msgstr "Căn lề"

#: prefs.js:119
msgid "Where the dock sits along that edge"
msgstr "Vị trí của dock dọc theo cạnh đó"

#: prefs.js:120
msgid "Center"
msgstr "Giữa"

#: prefs.js:121
msgid "Start"
msgstr "Bắt đầu"

#: prefs.js:122
msgid "End"
msgstr "Kết thúc"

#: prefs.js:126
msgid "Show in the overview"
msgstr "Hiện trong Overview"

#: prefs.js:126
msgid "Keep the dock in the overview in place of the built-in dash"
msgstr "Giữ dock trong Overview thay cho Dash có sẵn"

#: prefs.js:128
msgid "Icon Size"
msgstr "Kích thước icon"

#: prefs.js:130
msgid "Icon size"
msgstr "Kích thước icon"

#: prefs.js:130
msgid "Size at rest, in pixels"
msgstr "Kích thước lúc nghỉ, tính bằng pixel"

#: prefs.js:132
msgid "Icon spacing"
msgstr "Khoảng cách icon"

#: prefs.js:132
msgid "Extra space between icons, in pixels"
msgstr "Khoảng trống thêm giữa các icon, tính bằng pixel"

#: prefs.js:134
msgid "Dock padding"
msgstr "Lề trong của dock"

#: prefs.js:134
msgid "Space between the icons and the border of the dock, in pixels"
msgstr "Khoảng cách giữa icon và viền dock, tính bằng pixel"

#: prefs.js:138
msgid "Launchers"
msgstr "Ứng dụng"

#: prefs.js:140
msgid "Show Apps Button"
msgstr "Nút Hiện ứng dụng"

#: prefs.js:142
msgid "Show Apps button"
msgstr "Nút Hiện ứng dụng"

#: prefs.js:142
msgid "Add a button that opens the app grid"
msgstr "Thêm nút mở kho ứng dụng"

#: prefs.js:144
msgid "Button position"
msgstr "Vị trí nút"

#: prefs.js:144
msgid "Where the button sits among the icons"
msgstr "Vị trí của nút so với các icon"

#: prefs.js:145
msgid "At the start"
msgstr "Ở đầu danh sách"

#: prefs.js:146
msgid "At the end"
msgstr "Ở cuối danh sách"

#: prefs.js:149
msgid "Running Apps"
msgstr "Ứng dụng đang chạy"

#: prefs.js:150
msgid "Apps that are running but not pinned are listed after the pinned ones."
msgstr "Ứng dụng đang chạy nhưng chưa ghim được xếp sau các ứng dụng đã ghim."

#: prefs.js:152
msgid "Separator"
msgstr "Vạch ngăn cách"

#: prefs.js:152
msgid "Draw a line between pinned apps and other running apps"
msgstr "Vẽ một vạch giữa ứng dụng đã ghim và các ứng dụng đang chạy khác"

#: prefs.js:154
msgid "Running indicators"
msgstr "Chỉ báo đang chạy"

#: prefs.js:154
msgid "Mark running apps with a dot"
msgstr "Đánh dấu ứng dụng đang chạy bằng một chấm"

#: prefs.js:156
msgid "Order of running apps"
msgstr "Thứ tự ứng dụng đang chạy"

#: prefs.js:156
msgid "Either way, icons never change places on their own"
msgstr "Dù chọn cách nào, icon cũng không tự đổi chỗ"

#: prefs.js:157
msgid "Order they were started"
msgstr "Theo thứ tự khởi chạy"

#: prefs.js:158
msgid "Name"
msgstr "Theo tên"

#: prefs.js:161
msgid "macOS Special Launchers"
msgstr "Mục đặc biệt kiểu macOS"

#: prefs.js:162
msgid "Shown at the end of the dock, after the apps."
msgstr "Hiện ở cuối dock, sau các ứng dụng."

#: prefs.js:164
msgid "Show Trash"
msgstr "Hiện Thùng rác"

#: prefs.js:164
msgid "Its icon tells whether it holds anything; right-click to empty it"
msgstr "Biểu tượng cho biết thùng rác có gì không; nhấp chuột phải để dọn sạch"

#: prefs.js:166
msgid "Show Downloads Folder"
msgstr "Hiện thư mục Tải về"

#: prefs.js:166
msgid "Right-click for the files changed last"
msgstr "Nhấp chuột phải để xem các tệp thay đổi gần đây nhất"

#: prefs.js:168
msgid "Stacks Fan View"
msgstr "Stack dạng cánh quạt"

#: prefs.js:168
msgid "Click the folder to fan out its latest files instead of opening it"
msgstr "Nhấp vào thư mục để xoè các tệp mới nhất ra thay vì mở thư mục"

#: prefs.js:170
msgid "Separate special items with divider"
msgstr "Ngăn cách các mục đặc biệt bằng vạch"

#: prefs.js:170
msgid "Draw a line between the apps and these items"
msgstr "Vẽ một vạch giữa các ứng dụng và những mục này"

#: prefs.js:174
msgid "Behavior"
msgstr "Hành vi"

#: prefs.js:176
msgid "Auto-hide"
msgstr "Tự động ẩn"

#: prefs.js:178
msgid "Intellihide"
msgstr "Ẩn thông minh"

#: prefs.js:178
msgid ""
"Hide the dock while a window overlaps it; windows may then use the whole "
"screen"
msgstr "Ẩn dock khi có cửa sổ đè lên; cửa sổ khi đó được dùng toàn bộ màn hình"

#: prefs.js:181
msgid "Hide delay"
msgstr "Độ trễ khi ẩn"

#: prefs.js:181
msgid "Milliseconds before the dock hides after the pointer leaves"
msgstr "Số mili giây trước khi dock ẩn sau khi con trỏ rời đi"

#: prefs.js:183
msgid "Show delay"
msgstr "Độ trễ khi hiện"

#: prefs.js:183
msgid "Milliseconds the pointer must rest on the screen edge"
msgstr "Số mili giây con trỏ phải dừng ở cạnh màn hình"

#: prefs.js:185
msgid "Mouse Actions"
msgstr "Tương tác chuột"

#: prefs.js:187
msgid "Click on the focused app"
msgstr "Nhấp vào ứng dụng đang dùng"

#: prefs.js:187
msgid "What clicking its icon again does"
msgstr "Hành động khi nhấp lại vào icon của nó"

#: prefs.js:188
msgid "Cycle through windows"
msgstr "Chuyển lần lượt qua các cửa sổ"

#: prefs.js:189
msgid "Minimize"
msgstr "Thu nhỏ"

#: prefs.js:190
msgid "Minimize, or cycle if several windows"
msgstr "Thu nhỏ, hoặc chuyển lần lượt nếu có nhiều cửa sổ"

#: prefs.js:191
msgid "Do nothing"
msgstr "Không làm gì"

#: prefs.js:194
msgid "Scroll to switch windows"
msgstr "Cuộn để chuyển cửa sổ"

#: prefs.js:194
msgid "Scrolling over an app icon steps through its windows"
msgstr "Cuộn chuột trên icon để chuyển qua các cửa sổ của ứng dụng đó"

#: prefs.js:196
msgid "Drag-and-Drop Install"
msgstr "Kéo thả để cài đặt"

#: prefs.js:198
msgid ""
"Drag an AppImage, Flatpak, RPM or DEB file onto the dock to install it and "
"pin it there"
msgstr "Kéo một tệp AppImage, Flatpak, RPM hoặc DEB vào dock để cài đặt và ghim nó lên dock"

#: prefs.js:202
msgid "Appearance"
msgstr "Giao diện"

#: prefs.js:204
msgid "Magnification"
msgstr "Hiệu ứng phóng to"

#: prefs.js:206
msgid "Magnify on hover"
msgstr "Phóng to khi rê chuột"

#: prefs.js:206
msgid "Icons near the pointer grow"
msgstr "Icon gần con trỏ sẽ lớn lên"

#: prefs.js:208
msgid "Maximum scale"
msgstr "Tỉ lệ phóng tối đa"

#: prefs.js:208
msgid "Size of the icon under the pointer, relative to its size at rest"
msgstr "Kích thước icon dưới con trỏ so với lúc nghỉ"

#: prefs.js:210
msgid "Background & Blur"
msgstr "Nền & Làm mờ"

#: prefs.js:212
msgid "Background opacity"
msgstr "Độ đậm của nền"

#: prefs.js:212
msgid "0 is fully transparent, 1 is opaque"
msgstr "0 là trong suốt hoàn toàn, 1 là đặc"

#: prefs.js:214
msgid "Corner radius"
msgstr "Độ bo góc"

#: prefs.js:214
msgid "Roundness of the dock, in pixels"
msgstr "Độ tròn góc của dock, tính bằng pixel"

#: prefs.js:216
msgid "Blur background"
msgstr "Làm mờ nền"

#: prefs.js:216
msgid "Show the wallpaper blurred behind the dock"
msgstr "Hiện hình nền được làm mờ phía sau dock"

#: prefs.js:219
msgid "Blur strength"
msgstr "Cường độ mờ"

#: prefs.js:219
msgid "Higher is blurrier"
msgstr "Càng cao càng mờ"

#: prefs.js:221
msgid "Blur brightness"
msgstr "Độ sáng lớp mờ"

#: prefs.js:221
msgid "0 is black, 1 leaves the wallpaper unchanged"
msgstr "0 là đen, 1 giữ nguyên hình nền"
